# Copy to .env on your server. Never commit real values.
PORT=8787
# Long random value. Needed to create API keys.
ADMIN_TOKEN=
# From console.anthropic.com. Turns on the AI assistant. Usage is billed to this account.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Set to 1 to let visitors without an API key use AI, limited per network address.
AI_PUBLIC=0
AI_DAILY_LIMIT=50
RATE_LIMIT_PER_MIN=120
DB_PATH=./veritas.db
